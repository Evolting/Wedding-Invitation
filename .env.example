# Biến môi trường cho Vercel Function /api/rsvp.
# KHÔNG commit giá trị thật. KHÔNG dùng prefix VITE_ (sẽ lộ ra browser).
# Đặt các biến này trong Vercel: Project > Settings > Environment Variables.

# URL Web App của Google Apps Script (kết thúc bằng /exec)
APPS_SCRIPT_WEB_APP_URL=

# Chuỗi bí mật server-to-server, phải khớp SHARED_SECRET trong Code.gs
APPS_SCRIPT_SHARED_SECRET=
